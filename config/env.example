# TopPay configuration. Copy these lines into your .env and adjust.
# Only VITE_ values reach the browser, so never put secrets in them.

# Optional: address of a deployed ArcSend contract. Leave empty if you have not deployed one.
# Payments are plain native USDC transfers and do not need it.
VITE_ARCSEND_CONTRACT_ADDRESS=

# Optional: your own Arc Mainnet RPC (https only), tried before the official endpoint.
VITE_ARC_RPC_URL=

# Optional: comma separated backup RPC URLs (https only), tried after the official endpoint.
VITE_ARC_RPC_FALLBACK_URLS=

# Optional: blocks per eth_getLogs request for history scanning (default 5000).
VITE_HISTORY_CHUNK_BLOCKS=

# Deployment only. NEVER prefix with VITE_ and never commit it.
# Set it in your shell when running `bun run deploy:arcsend`:
# DEPLOYER_PRIVATE_KEY=
